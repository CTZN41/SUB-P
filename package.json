{
  "name": "basketball-shot-analysis",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c green,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "test": "backend\\.venv\\Scripts\\python.exe -m pytest backend/tests -q",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
