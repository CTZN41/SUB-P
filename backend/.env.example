# 실행 환경입니다. 로컬 개발에서는 development를 사용합니다.
APP_ENV=development

# SQLite 데이터베이스 파일 위치입니다.
DATABASE_URL=sqlite:///./data/shotmap.db

# 원본 영상과 분석 임시 파일을 저장할 폴더입니다.
UPLOAD_DIR=./uploads
WORK_DIR=./work

# 한 영상의 최대 길이와 최대 크기입니다.
MAX_VIDEO_MINUTES=10
MAX_VIDEO_BYTES=5368709120

# OpenAI 연동은 이후 분석 Phase에서 사용합니다.
# 실제 키는 .env에만 입력하고 Git이나 문서에 기록하지 않습니다.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_TIMEOUT_SECONDS=60

LOG_LEVEL=INFO
