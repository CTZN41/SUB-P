# 실행 환경입니다. 로컬 개발에서는 development를 사용합니다.
APP_ENV=development

# Supabase 대시보드의 Session pooler 연결 문자열입니다.
# USER, PASSWORD, HOST를 실제 값으로 바꾸고 이 파일이 아닌 backend/.env에 입력합니다.
# 비밀번호에 특수문자가 있으면 URL 인코딩이 필요합니다.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# 원본 영상과 분석 임시 파일을 저장할 폴더입니다.
UPLOAD_DIR=./uploads
WORK_DIR=./work

# 한 영상의 최대 길이와 최대 크기입니다.
MAX_VIDEO_MINUTES=10
MAX_VIDEO_BYTES=5368709120

# YOLO가 찾은 슛 후보 장면을 OpenAI가 보조 검토합니다.
# 실제 키는 backend/.env에만 입력하고 Git이나 문서에 기록하지 않습니다.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6.1-terra
OPENAI_VISION_FALLBACK_MODEL=gpt-6.1-sol
OPENAI_TIMEOUT_SECONDS=60
OPENAI_SHOT_REVIEW_ENABLED=true
OPENAI_MAX_CANDIDATE_REVIEWS=40

LOG_LEVEL=INFO
